{
  "name": "agent-work-layer-repo",
  "private": true,
  "description": "Monorepo for agent-work-layer (packages/core) and agent-work-layer-mcp (packages/mcp).",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/mcp"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "pretypecheck": "npm run build -w agent-work-layer",
    "typecheck": "npm run typecheck --workspaces",
    "pretest": "npm run build -w agent-work-layer",
    "test": "npm test --workspaces",
    "test:coverage": "npm run test:coverage -w agent-work-layer",
    "test:package": "npm run build && node scripts/package-smoke.ts",
    "check": "npm run typecheck && npm test && npm run test:package",
    "generate": "npm run generate -w agent-work-layer"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
