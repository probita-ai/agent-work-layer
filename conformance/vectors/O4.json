{
  "rule": "O4",
  "check": "order",
  "description": "`output_schema`, if present, is a valid JSON Schema.",
  "vectors": [
    {
      "name": "accepts a valid output_schema",
      "order": {
        "spec": "awl/work-order@0.3",
        "id": "wo_1",
