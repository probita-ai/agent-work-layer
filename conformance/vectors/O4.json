        "from": "agent:manager",
        "to": "agent:worker",
        "goal": "Summarize the risk factors in the annual report",
        "criteria": [
          {
            "id": "c1",
            "text": "Lists three risk factors with quotes"
          },
          {
            "id": "c2",
            "text": "States total debt and fiscal year"
          }
        ],
        "budget": {
          "usd": 2,
          "tool_calls": 20
        },
        "deadline": "2026-01-01T12:00:00Z",
        "tools": [
          "filings/*",
          "calc/ratio"
        ],
        "output_schema": {
          "type": "object",
          "required": [
            "risks"
          ],
          "properties": {
            "risks": {
              "type": "array",
              "minItems": 3,
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "expect": []
    },
    {
