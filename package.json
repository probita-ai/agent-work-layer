{
  "name": "agent-work-layer",
  "version": "0.1.1",
  "description": "Work Orders and Work Reports for AI agents: a typed SDK, validator, lifecycle desk and MCP server.",
  "keywords": [
    "ai",
    "agents",
    "multi-agent",
    "mcp",
    "model-context-protocol",
    "a2a",
    "work-order",
    "llm",
    "orchestration"
  ],
  "license": "Apache-2.0",
  "author": "Probita",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js"
    },
    "./schemas/work-order.schema.json": "./schemas/work-order.schema.json",
    "./schemas/work-report.schema.json": "./schemas/work-report.schema.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "awl": "dist/cli.js"
  },
  "files": [
    "dist",
    "schemas",
    "SPEC.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" \"test/**/*.test.ts\"",
    "test:package": "npm run build && node scripts/package-smoke.ts",
    "check": "npm run typecheck && npm test && npm run test:package",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/probita-ai/agent-work-layer.git"
  },
  "homepage": "https://github.com/probita-ai/agent-work-layer#readme",
  "bugs": {
    "url": "https://github.com/probita-ai/agent-work-layer/issues"
  }
}
